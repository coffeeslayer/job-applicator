DICE_EMAIL=your-dice-email@example.com
DICE_PASSWORD=replace-with-your-dice-password
GLASSDOOR_EMAIL=your-glassdoor-email@example.com
GLASSDOOR_PASSWORD=replace-with-your-glassdoor-password
LINKEDIN_EMAIL=replace-with-your-linkedin-email@example.com
LINKEDIN_PASSWORD=replace-with-your-linkedin-password

# Per-job resume tailoring (shared by LinkedIn, Dice, Greenhouse, and Glassdoor)
# Provider: auto (default: uses Gemini if GEMINI_API_KEY is set, else local model), gemini, local, or off
RESUME_TAILOR_PROVIDER=auto
GEMINI_API_KEY=replace-with-your-gemini-api-key
GEMINI_MODEL=gemini-3.8-flash
# Optional local OpenAI-compatible model endpoint (also used for form answer drafts)
# LINKEDIN_JOB_SEARCH_LOCAL_MODEL_URL=http://127.0.0.1:1234/v1
# LINKEDIN_JOB_SEARCH_LOCAL_MODEL=your-local-model-name
